# Port for Express server on Render (Render sets PORT automatically, e.g. 10000)
PORT=10000
NODE_ENV=production

# JWT secret key for token authentication
JWT_SECRET=production_super_secret_shoppos_key_change_me_992144

# MongoDB Atlas Connection URI (Get free from mongodb.com)
# Example: mongodb+srv://dbUser:Password123@cluster0.abcde.mongodb.net/shoppos?retryWrites=true&w=majority
MONGODB_URI=

# Allowed origins for CORS (e.g., your owner static frontend URL on Render)
# Example: https://shop-pos-owner.onrender.com or *
ALLOWED_ORIGINS=*
